# ===================================
# Novel Insight MVP - Docker Compose 환경변수
# ===================================
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요
# cp .env.example .env
# ===================================

# ===================================
# MySQL 설정
# ===================================
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=novel_insight
MYSQL_USER=novel_user
MYSQL_PASSWORD=your_mysql_password_here

# ===================================
# RabbitMQ 설정
# ===================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here

# ===================================
# Timezone
# ===================================
TZ=Asia/Seoul
