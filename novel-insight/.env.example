# ===================================
# Novel Insight - 백엔드 Spring Boot 환경변수
# ===================================
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요
# cp .env.example .env
# ===================================

# ===================================
# 데이터베이스 설정
# ===================================
# MySQL 데이터베이스 URL
# 로컬 개발: jdbc:mysql://localhost:3306/novel_insight
# Docker: jdbc:mysql://novel-mysql:3306/novel_insight
DB_URL=jdbc:mysql://localhost:3306/novel_insight?useSSL=false&allowPublicKeyRetrieval=true

# 데이터베이스 사용자 이름
DB_USERNAME=novel_user

# 데이터베이스 비밀번호 (민감 정보 - 절대 Git에 커밋하지 마세요!)
DB_PASSWORD=your_password_here

# ===================================
# JWT 토큰 설정
# ===================================
# JWT 서명에 사용되는 비밀키 (최소 32자 이상 권장)
# 프로덕션 환경에서는 강력한 랜덤 문자열을 사용하세요
# 예: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long

# JWT 발급자 (Issuer)
JWT_ISSUER=novel-insight

# JWT 액세스 토큰 유효 시간 (시간 단위)
JWT_ACCESS_DURATION_HOUR=24

# ===================================
# Kafka 설정
# ===================================
# Kafka 브로커 주소
# 로컬 개발: localhost:9092
# Docker: novel-kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka Consumer Group ID
KAFKA_GROUP_ID=novel-insight-group

# ===================================
# Redis 설정 (선택사항)
# ===================================
# Redis 호스트
REDIS_HOST=localhost

# Redis 포트
REDIS_PORT=6379

# ===================================
# Python 분석 서비스 URL
# ===================================
# FastAPI 분석 서비스 주소
PYTHON_SERVICE_URL=http://localhost:8000

# ===================================
# 애플리케이션 설정
# ===================================
# 서버 포트
SERVER_PORT=8080

# 프로파일 (local, dev, prod)
SPRING_PROFILES_ACTIVE=local

# 로그 레벨 (TRACE, DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL=INFO
