# ===================================
# Novel Insight - 백엔드 Spring Boot 환경변수
# ===================================
# ⚠️  이 파일은 Git에 커밋되지 않습니다 (.gitignore에 포함)
# ⚠️  실제 프로덕션 환경에서는 강력한 비밀번호로 변경하세요!
# ===================================

# ===================================
# 데이터베이스 설정
# ===================================
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ===================================
# JWT 토큰 설정
# ===================================
JWT_SECRET=
JWT_ISSUER=novel-insight

# 실무 권장 토큰 유효기간 (Production Best Practices)
# Access Token: 1시간 (짧을수록 안전)
# Refresh Token: 14일 (편의성과 보안의 균형)
JWT_ACCESS_DURATION_HOUR=1
JWT_REFRESH_DURATION_DAY=14

# ===================================
# Kafka 설정
# ===================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=novel-insight-group

# ===================================
# Redis 설정
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===================================
# Python 분석 서비스 URL
# ===================================
PYTHON_SERVICE_URL=

# ===================================
# 애플리케이션 설정
# ===================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
LOGGING_LEVEL=DEBUG
SHOW_SQL=true
DDL_AUTO=update
BATCH_ENABLED=false
