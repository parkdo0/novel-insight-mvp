# ===================================
# Novel Insight - Python 분석 서비스 환경변수
# ===================================
# ⚠️  이 파일은 Git에 커밋되지 않습니다 (.gitignore에 포함)
# ⚠️  실제 프로덕션 환경에서는 강력한 비밀번호로 변경하세요!
# ===================================

# ===================================
# Kafka 설정
# ===================================
# Docker 네트워크 내부에서 실행 시: novel-kafka:29092
# 로컬에서 직접 실행 시: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=novel-kafka:29092
KAFKA_TOPIC=novel-reviews
KAFKA_GROUP_ID=python-consumer-group

# ===================================
# MySQL 데이터베이스 설정
# ===================================
# Docker 네트워크 내부에서 실행 시: novel-mysql
# 로컬에서 직접 실행 시: localhost
DB_HOST=novel-mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=novel_insight

# ===================================
# 애플리케이션 설정
# ===================================
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
