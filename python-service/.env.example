# ===================================
# Novel Insight - Python 분석 서비스 환경변수
# ===================================
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요
# cp .env.example .env
# ===================================

# ===================================
# Kafka 설정
# ===================================
# Kafka 브로커 서버 주소
# 로컬 개발: localhost:9092
# Docker 네트워크 내부: novel-kafka:29092
KAFKA_BOOTSTRAP_SERVERS=novel-kafka:29092

# Kafka 토픽 이름 (Spring Boot에서 발행하는 토픽과 일치해야 함)
KAFKA_TOPIC=novel-reviews

# Kafka Consumer Group ID
KAFKA_GROUP_ID=python-consumer-group

# ===================================
# MySQL 데이터베이스 설정
# ===================================
# 데이터베이스 호스트
# 로컬 개발: localhost
# Docker 네트워크 내부: novel-mysql
DB_HOST=novel-mysql

# MySQL 포트
DB_PORT=3306

# 데이터베이스 사용자 이름
DB_USER=novel_user

# 데이터베이스 비밀번호 (민감 정보 - 절대 Git에 커밋하지 마세요!)
DB_PASSWORD=your_password_here

# 데이터베이스 이름
DB_NAME=novel_insight

# ===================================
# 애플리케이션 설정
# ===================================
# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# FastAPI 서버 포트
PORT=8000

# FastAPI 서버 호스트
HOST=0.0.0.0

# ===================================
# KoNLPy 설정 (선택사항)
# ===================================
# Java Home 경로 (KoNLPy가 JVM을 사용하므로 필요)
# 예: /usr/lib/jvm/java-11-openjdk-amd64
# JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
