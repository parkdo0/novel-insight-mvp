# ===================================
# Novel Insight - 프론트엔드 Vue.js 환경변수
# ===================================
# 이 파일을 복사하여 .env.development 또는 .env.production 파일을 만드세요
# cp .env.example .env.development
# ===================================

# ===================================
# API 서버 설정
# ===================================
# 백엔드 API 서버 Base URL
# 개발 환경: http://localhost:8080
# 프로덕션: https://api.yourproject.com
VITE_API_BASE_URL=http://localhost:8080

# ===================================
# 애플리케이션 설정
# ===================================
# 애플리케이션 제목
VITE_APP_TITLE=Novel Insight

# API 요청 타임아웃 (밀리초)
VITE_API_TIMEOUT=10000

# ===================================
# 기능 플래그 (Feature Flags)
# ===================================
# 디버그 모드 활성화
VITE_DEBUG_MODE=false

# 개발자 도구 표시
VITE_SHOW_DEV_TOOLS=false
